{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitGalaxy Shell",
  "version": "0.1.0",
  "identifier": "com.bitgalaxy.shell.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:5177"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BitGalaxy Shell 工作台",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
