{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "AI 基座（P6 后台服务化）：宠物窗加载 /pet/（frontendDist / dev 同一 vite 17177 MPA），remote 上下文需显式授权 IPC（拉起工具 / 桌宠开关 / 退出 / 动作包管理 + 剪贴板）",
  "windows": ["pet"],
  "remote": {
    "urls": ["http://localhost:17177", "http://127.0.0.1:17177"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "allow-launch-tool",
    "allow-builtin-pack-root",
    "allow-set-pet-visible",
    "allow-quit-app"
  ]
}
