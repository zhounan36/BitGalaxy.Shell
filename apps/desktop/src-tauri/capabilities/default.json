{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "主窗口与宠物窗的默认能力：核心 API + 原生窗口拖拽。主窗加载内嵌工作台（frontendDist / dev 为 vite 5177）；宠物窗 dev 加载 vite（localhost:5178），remote 上下文需显式授权 IPC（事件互通 + 上传用本地文件读取）",
  "windows": ["main", "pet"],
  "remote": {
    "urls": ["http://localhost:5177", "http://127.0.0.1:5177", "http://localhost:5178"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "allow-show-main-window",
    "allow-dbg-evt",
    "allow-set-pet-visible",
    "allow-quit-app",
    "allow-stat-file",
    "allow-read-file-chunk"
  ]
}
