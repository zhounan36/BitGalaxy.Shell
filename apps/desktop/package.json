{
  "name": "@bgshell/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "BitGalaxy Shell 桌面应用（Tauri 2 单进程）：内嵌 Agent（SSH/WS/MCP）+ 工作台 + 桌宠 + 托盘",
  "scripts": {
    "tauri": "tauri",
    "dev": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri dev",
    "build": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri build",
    "build:exe-only": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
