{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitGalaxy SQL",
  "version": "0.1.0",
  "identifier": "com.bitgalaxy.shell.sql",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BitGalaxy SQL",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": ["drivers/*/host.exe"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
