# 依赖
node_modules/

# 构建产物
dist/
dist-app/
build/
out/
*.tsbuildinfo
/target/
# 根 workspace 合并前的旧构建缓存（可手动删除释放磁盘）
apps/desktop/src-tauri/target/
drivers/target/
# SQL 驱动宿主内置资产（scripts/prep-drivers.mjs 产出，随安装包打包）
apps/desktop/src-tauri/drivers/
apps/desktop/src-tauri/binaries/*.exe

# Tauri 前端分发产物（scripts/prep-assets.mjs 从 workbench-ui/dist 拷贝，整目录删除重建）
apps/*/ui/

# Tauri 构建期自动生成
apps/*/src-tauri/gen/schemas/
apps/*/src-tauri/permissions/autogenerated/

# 资源处理工作区产物（宠物图生成/规范化管线，无源码引用）
/assets/

# 日志
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量与密钥
.env
.env.*
!.env.example

# 缓存
.npm/
.vite/
.eslintcache
.stylelintcache
*.cache/

# 测试覆盖率
coverage/

# SEA 打包中间产物（dist-app 下，双保险）
*.exe
sea.blob

# 编辑器
.trae/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
